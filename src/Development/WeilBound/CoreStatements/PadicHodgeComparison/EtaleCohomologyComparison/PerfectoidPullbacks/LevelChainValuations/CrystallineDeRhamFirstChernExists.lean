    ((B.basePt F τ h).app B' y).1.2 = y.1.2 := rfl

theorem pt_ok (M : Model l K) (n : ℕ) (B' : CommRingCat.{0}) (y : PtOver M.X M.p (B.κb (okToOC l K) false n) B') :
